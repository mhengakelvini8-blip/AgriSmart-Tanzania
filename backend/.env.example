# Copy this file to .env and fill in real values before deploying.
# In development, if JWT_SECRET is left unset, the server generates
# one automatically on first run and saves it here for you.

NODE_ENV=development
PORT=5000

# A long, random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login stays valid.
JWT_EXPIRES_IN_SECONDS=604800

# Where the local SQLite database file is stored (used only when
# TURSO_DATABASE_URL below is empty).
DB_PATH=../data/agrismart.sqlite

# Leave both blank for local development (uses the local SQLite file
# above instead). Set both when deploying somewhere that doesn't keep
# local files between restarts (e.g. Render's free tier) — see README
# "Deploying for free" for how to create a free Turso database and get
# these two values.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Restrict this to your real frontend URL in production, e.g.
# https://agrismarttanzania.co.tz — "*" is fine for local development.
CORS_ORIGIN=https://your-frontend-domain.pages.dev

# Used only to seed the very first admin account if none exists yet.
# Change these, then change the password again from the admin panel
# (or via forgot-password) before going live.
DEFAULT_ADMIN_USERNAME=choose-a-unique-admin-name
DEFAULT_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-chars
DEFAULT_ADMIN_EMAIL=you@yourdomain.com

# Resend email delivery for password resets (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
EMAIL_FROM=AgriSmart Tanzania <no-reply@your-verified-domain.com>
