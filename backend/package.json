{
  "name": "agrismart-tanzania-backend",
  "version": "2.0.0",
  "description": "AgriSmart Tanzania API - Express-style REST API with a real database (local SQLite or hosted Turso), JWT auth, and only one external dependency",
  "main": "server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "migrate": "node --disable-warning=ExperimentalWarning scripts/migrate-json-to-sqlite.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0"
  }
}
